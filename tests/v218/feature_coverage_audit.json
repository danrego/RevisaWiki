  "surroundingFeatures": [
    {
      "id": "date-helper-functions",
      "verification": "source-inspection-and-descriptor-witnesses",
      "coverage": "Month conversion, date-family wrappers and fallback handling are exercised through the date and maintenance descriptors. One witness per descriptor does not prove every possible regex input safe."
    },
    {
      "id": "duplicate-value-parser",
      "verification": "source-inspection-and-descriptor-witnesses",
      "coverage": "The nested-value parser supplies the eight duplicate descriptors. RevisaWiki removes identical duplicates while preserving conflicting and empty overrides, rather than copying the original value-selection changes."
    },
    {
      "id": "nested-substitution-and-scope",
      "verification": "source-inspection",
      "coverage": "RevisaWiki uses protected-source parsing, native destination contracts and source-bound edits. It does not copy the same nested scanning implementation or assume the same processing scope."
    },
    {
      "id": "bounded-repeat-orchestration",
      "verification": "source-inspection",
      "coverage": "The original fixed-point loops and pass caps are replaced by staged bounded plans and idempotence checks. Equal iteration counts are not a feature-parity claim."
    },
    {
      "id": "syntax-validation",
      "verification": "source-inspection",
      "coverage": "Structural scans, preservation guards and bounded recovery provide validation. RevisaWiki does not reproduce the original whole-page abort, warning and bypass flow."
    },
    {
      "id": "manual-action-and-source-editors",
      "verification": "source-inspection-not-a-fresh-browser-test",
      "coverage": "Both tools provide a manual adjustment action and source editor integration. Current RevisaWiki adapters support classic/CodeMirror and the 2017 source editor."
    },
    {
      "id": "true-visual-editor",
      "verification": "explicit-current-adapter-contract",
      "coverage": "The original can obtain wikitext from true VisualEditor mode and hand it to a source diff form. Current RevisaWiki explicitly declines true visual mode. Switch to source editing."
    },
    {
      "id": "active-wiked-editor",
      "verification": "explicit-current-adapter-contract",
      "coverage": "The original integrates with wikEd. Current RevisaWiki explicitly declines an active wikEd adapter rather than modify an unconfirmed editor model."
    },
    {
      "id": "category-and-backlink-launchers",
      "verification": "source-inspection",
      "coverage": "The two original browser HTML descriptors append JavaScript Edit launchers to category and backlinks results. RevisaWiki does not provide this category/backlinks batch launcher."
    },
    {
      "id": "edit-summary",
      "verification": "source-inspection",
      "coverage": "The original prepends generic feature summaries. RevisaWiki describes retained changes and preserves a summary manually written by the editor. The exact original summary format is not copied."
    },
    {
      "id": "minor-edit-marking",
      "verification": "source-inspection",
      "coverage": "The original always checks the available minor-edit control after adjustment. RevisaWiki requires a confirmed mechanical-change proof and source-revision confirmation."
    },
    {
      "id": "native-diff-workflow",
      "verification": "source-inspection",
      "coverage": "The original automatically invokes a native diff or submits a diff form. RevisaWiki exposes the native comparison control while leaving publication with the editor."
    },
    {
      "id": "browser-controls-and-shortcuts",
      "verification": "source-inspection",
      "coverage": "Original button cloning, access-key changes, delayed polling and editor navigation are not copied as an identical interface. RevisaWiki has its own mounting, cancellation, undo and editor safeguards."
    },
    {
      "id": "session-error-logging-option",
      "verification": "source-inspection",
      "coverage": "The original changes a session error-logging opt-out. RevisaWiki does not copy this browser setting, which is not an article-text correction."
    }
  ],
  "claims": {
    "supported": "The complete pinned source was reviewed, including active article transformations and surrounding helpers, validation, summaries and browser/editor controls.",
    "notSupported": "RevisaWiki is not an exact replacement for every feature or every browser workflow of the other gadget. The 241-rule witness count is not exhaustive regex-input coverage, byte parity or complete UI parity."
  },
