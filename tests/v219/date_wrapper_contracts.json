        "Date"
      ],
      "action": "preserve-entire-native-call",
      "reason": "Already accepted local implementations have their own link, age, microformat and category semantics. In particular Birth date and the two Death date implementations do not emit birth/death year categories, whereas Dni/Morte do by default. Date is a native local name and must not inherit a French template interface."
    },
    {
      "identities": [
        "Date de naissance",
        "modèle:date de naissance"
      ],
      "action": "quietly-refuse-unproved-migration",
      "reason": "A generic foreign birth-date call does not prove that this page is its subject biography or authorize new birth-year/living-person categories. No category or microformat equivalence has been established for conversion to Dni."
    },
    {
      "identities": [
        "Nascimento",
        "Birth date and age",
        "Falecimento",
        "Falecimento e idade",
        "Morte e idade"
      ],
      "action": "retain-existing-bounded-positional-migration",
      "reason": "These exact local wrappers already delegate to Dni/Morte. Their three/six numeric positional calls are covered separately, with the original wrapper calendar, age and category behavior."
    }
