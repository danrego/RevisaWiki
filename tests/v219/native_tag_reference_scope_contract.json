  "source": "MARK_plain_DEF<ref name=\"tag_plain\">BODY_plain</ref> MARK_plain_USE{{#tag:ref||name=tag_plain}} END_plain\n\nMARK_poem_DEF<ref name=\"tag_poem\">BODY_poem</ref> MARK_poem_USE<poem>{{#tag:ref||name=tag_poem}}</poem> END_poem\n\nMARK_gallery_DEF<ref name=\"tag_gallery\">BODY_gallery</ref> MARK_gallery_USE<gallery>\nFile:Example.jpg|Legenda {{#tag:ref||name=tag_gallery}}\n</gallery> END_gallery\n\nMARK_packed_DEF<ref name=\"tag_packed\">BODY_packed</ref> MARK_packed_USE<gallery mode=\"packed\">\nFile:Example.jpg|Legenda {{#tag:ref||name=tag_packed}}\n</gallery> END_packed\n\nMARK_imagemap_DEF<ref name=\"tag_imagemap\">BODY_imagemap</ref> MARK_imagemap_USE<imagemap>\nFile:Example.jpg|thumb|Legenda {{#tag:ref||name=tag_imagemap}}\nrect 0 0 100 100 [[Tema fictício]]\ndesc bottom-left\n</imagemap> END_imagemap\n\nMARK_attribute_DEF<ref name=\"tag_attribute\">BODY_attribute</ref> MARK_attribute_USE<span title=\"{{#tag:ref||name=tag_attribute}}\">Texto literal.</span> END_attribute\n\nMARK_code_DEF<ref name=\"tag_code\">BODY_code</ref> MARK_code_USE<code>{{#tag:ref||name=tag_code}}</code> END_code\n\nMARK_nowiki_DEF<ref name=\"tag_nowiki\">BODY_nowiki</ref> MARK_nowiki_USE<nowiki>{{#tag:ref||name=tag_nowiki}}</nowiki> END_nowiki\n<references />",
