  "source": "BEFORE\n<ref name=\"before_alpha\">BODY_BEFORE</ref> <ref name=\"before_beta\">BODY_BEFORE</ref> LITERAL_BEFORE{{r|before_beta}}\nEND_BEFORE\nAFTER\n<ref name=\"after_alpha\">BODY_AFTER</ref> <ref name=\"after_alpha\" /> LITERAL_AFTER{{r|after_beta}}\nEND_AFTER\nCODE_BEFORE\n<ref name=\"code_alpha\">BODY_CODE</ref> <ref name=\"code_beta\">BODY_CODE</ref> CODE_REUSE<code>{{r|code_beta}}</code>\nEND_CODE\n<references />",
